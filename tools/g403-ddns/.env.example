# ---- where the WAN IP comes from -------------------------------------------
# omada  = ask the Omada controller for the gateway's WAN port address (default)
# public = ask a public echo service what IP we appear from (use behind double NAT)
IP_SOURCE=omada
INTERVAL_SECONDS=60
# 0 disables the /healthz-style JSON endpoint
HEALTH_PORT=8080

# ---- Omada controller (IP_SOURCE=omada) -------------------------------------
OMADA_URL=https://omada.example.internal:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# optional: auto-discovered from /api/info when empty
OMADA_OMADAC_ID=
# optional: required only when the controller has more than one site
OMADA_SITE=
# optional: pin a gateway (AA-BB-CC-DD-EE-FF); default = first gateway in the site
OMADA_GATEWAY_MAC=
# optional: pin a WAN port by name (e.g. WAN1); default = first connected WAN
OMADA_WAN_PORT=
# set to false when talking straight to :8043 with its self-signed certificate
OMADA_TLS_VERIFY=true

# ---- Cloudflare --------------------------------------------------------------
CF_API_TOKEN=
CF_RECORD_NAME=vpn.example.com
# optional: derived from CF_RECORD_NAME when empty
CF_ZONE_NAME=
CF_TTL=60
CF_PROXIED=false
